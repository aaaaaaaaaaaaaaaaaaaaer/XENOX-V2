    local function applyFilter(tab, query)
        if not tab then
            return
        end
        query = tostring(query or ""):lower()

        for _, entry in ipairs(tab.entries) do
            if entry.frame and entry.frame.Parent then
                if query == "" then
                    entry.frame.Visible = true
                elseif entry.section then
                    entry.frame.Visible = false
                else
                    entry.frame.Visible = entry.text:lower():find(query, 1, true) ~= nil
                end
            end
        end
    end

    local function activateTab(id)
        local tab = tabs[id]
        if not tab then
            return
        end

        activeTabId = id
        for otherId, other in pairs(tabs) do
            other.page.Visible = otherId == id
            other.setActive(otherId == id)
        end

        pageTitle.Text = tab.name
        pageDescription.Text = tab.description
        pageDescription.Visible = tab.description ~= ""
        pageTitle.Position = UDim2.fromOffset(
            18,
            tab.description ~= "" and 12 or 20
        )

        applyFilter(tab, searchBox.Text)

        tab.page.Position = UDim2.fromOffset(0, 6)
        safeTween(tab.page, ANIM.Normal, { Position = UDim2.fromOffset(0, 0) })
    end

