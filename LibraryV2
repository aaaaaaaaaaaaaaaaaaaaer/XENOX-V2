            local hitbox = create("TextButton", {
                Position = UDim2.fromOffset(12, 31),
                Size = UDim2.new(1, -24, 0, 18),
                BackgroundTransparency = 1,
                Text = "",
                AutoButtonColor = false,
            }, row)

            local function setValue(newValue, fire)
                value = math.clamp(tonumber(newValue) or min, min, max)
                local alpha = (max == min) and 0 or (value - min) / (max - min)
                -- Set directly: tweens on a dragged slider lag behind the cursor.
                valueLabel.Text = tostring(value)
                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                if fire and type(callback) == "function" then
                    pcall(callback, value)
                end
            end

            local dragging = false

            local function updateFromInput(input)
                if hitbox.AbsoluteSize.X < 1 then
                    return
                end
                local alpha = math.clamp(
                    (input.Position.X - hitbox.AbsolutePosition.X) / hitbox.AbsoluteSize.X,
                    0,
                    1
                )
                local raw = min + alpha * (max - min)
                setValue(math.floor(raw + 0.5), true)
            end

            table.insert(Window._connections, hitbox.InputBegan:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
                    and input.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end
                dragging = true
                updateFromInput(input)
                safeTween(knob, ANIM.Fast, { Size = UDim2.fromOffset(4, 14) })
            end))

            table.insert(Window._connections, UserInputService.InputChanged:Connect(function(input)
                if not dragging then
                    return
                end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement
                    and input.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end
                updateFromInput(input)
            end))

            table.insert(Window._connections, UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        safeTween(knob, ANIM.Fast, { Size = UDim2.fromOffset(2, 12) })
                    end
                end
            end))

            setValue(value, false)
            attachTooltip(row, description)
            addEntry(row, key)

            if type(callback) == "function" then
                task.defer(function()
                    pcall(callback, value)
                end)
            end
        end

