                Text = "",
                ZIndex = 603,
            }, popup).MouseButton1Down:Connect(function()
                activeDrag = "saturation"
            end)

            create("TextButton", {
                Position = UDim2.fromOffset(180, 12),
                Size = UDim2.fromOffset(12, 156),
                BackgroundTransparency = 1,
                Text = "",
                ZIndex = 603,
            }, popup).MouseButton1Down:Connect(function()
                activeDrag = "hue"
            end)

            table.insert(Window._connections, RunService.RenderStepped:Connect(function()
                if not activeDrag or not isOpen or not popup.Parent then
                    return
                end

                local mouse = UserInputService:GetMouseLocation()

                if activeDrag == "hue" then
                    hue = math.clamp(
                        (mouse.Y - hueBar.AbsolutePosition.Y)
                            / math.max(hueBar.AbsoluteSize.Y, 1),
                        0,
                        1
                    )
                else
                    saturation = math.clamp(
                        (mouse.X - saturationBox.AbsolutePosition.X)
                            / math.max(saturationBox.AbsoluteSize.X, 1),
                        0,
                        1
                    )
                    value = 1 - math.clamp(
                        (mouse.Y - saturationBox.AbsolutePosition.Y)
                            / math.max(saturationBox.AbsoluteSize.Y, 1),
                        0,
                        1
                    )
                end

                render(true)
            end))

            table.insert(Window._connections, UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    activeDrag = nil
                end
            end))

            table.insert(Window._connections, UserInputService.InputBegan:Connect(function(input)
                if not isOpen or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
