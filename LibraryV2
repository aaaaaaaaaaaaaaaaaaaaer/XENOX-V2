    function Window:Toggle(force)
        local nextState = force
        if nextState == nil then
            nextState = not isOpen
        end
        isOpen = nextState == true

        if isOpen then
            main.Visible = true
            uiScale.Scale = 0.97
            safeTween(uiScale, ANIM.Normal, { Scale = 1 })
        else
            closePopovers()
            uiScale.Scale = 1
            safeTween(uiScale, ANIM.Fast, { Scale = 0.97 })
            task.delay(0.12, function()
                if not isOpen then
                    main.Visible = false
                end
            end)
        end
    end

    function Window:SetTheme(newTheme)
        if type(newTheme) ~= "table" then
            return
        end
        theme = mergeTheme(theme, newTheme)
        Window._theme = theme
        refreshTheme()
    end

    function Window:SetAccent(color)
        if typeof(color) ~= "Color3" then
            return
        end
        Window:SetTheme({ Accent = color })
    end

    function Window:GetTheme()
        local copy = {}
        for key, value in pairs(theme) do
            copy[key] = value
        end
        return copy
    end

    function Window:SetToggleKey(key)
        if typeof(key) == "EnumItem" then
            toggleKey = key
            footerLabel.Text = "Toggle  " .. tostring(key.Name)
        end
    end

    function Window:Destroy()
        if Window._destroyed then
            return
        end
        Window._destroyed = true

        closePopovers()
        for _, connection in ipairs(Window._connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        if type(closeCallback) == "function" then
            pcall(closeCallback)
        end
        if getgenv then
            getgenv().XELIB_ActiveGui = nil
            getgenv().XELIB_ToggleBtn = nil
        end
        pcall(function()
            screenGui:Destroy()
        end)
        pcall(function()
            if toggleButton then
                toggleButton:Destroy()
            end
        end)
    end

    Window.Close = Window.Destroy

    -- Controls ---------------------------------------------------------------

    closeButton.MouseButton1Click:Connect(function()
        Window:Destroy()
    end)

    local function setMinimized(state)
        isMinimized = state

        if isMinimized then
            minimizedSize = main.Size
            sidebar.Visible = false
            content.Visible = false
            minimizeSecond.Visible = true
            safeTween(main, ANIM.Normal, {
                Size = UDim2.new(minimizedSize.X.Scale, minimizedSize.X.Offset, 0, HEADER_HEIGHT),
            })
        else
            sidebar.Visible = true
            content.Visible = true
            minimizeSecond.Visible = false
            safeTween(main, ANIM.Normal, {
                Size = minimizedSize or windowSize,
            })
        end
    end

    minimizeButton.MouseButton1Click:Connect(function()
        setMinimized(not isMinimized)
    end)

    makeDraggable(main, header, screenGui, Window._connections)

    if UserInputService.TouchEnabled or UserInputService.GamepadEnabled or config.Toggle == true then
        toggleButton = create("TextButton", {
            Name = "Toggle",
            Size = UDim2.fromOffset(40, 40),
            Position = UDim2.fromOffset(24, 24),
            BackgroundColor3 = theme.Surface,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 700,
        }, screenGui)
        addCorner(toggleButton, 10)
        local toggleStroke = addStroke(toggleButton, theme.Stroke, 1, 0.1)

        local iconImage = config.ToggleIcon
        if type(iconImage) == "string" and iconImage ~= "" then
            create("ImageLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(11, 11),
                Size = UDim2.fromOffset(18, 18),
                Image = iconImage,
                ZIndex = 702,
            }, toggleButton)
        else
            for index = 1, 3 do
                create("Frame", {
                    Position = UDim2.fromOffset(13, 12 + (index - 1) * 7),
                    Size = UDim2.fromOffset(14, 1),
                    BackgroundColor3 = theme.Text,
                    BorderSizePixel = 0,
                    ZIndex = 702,
                }, toggleButton)
            end
        end

        bindTheme(function(active)
            toggleButton.BackgroundColor3 = active.Surface
            toggleStroke.Color = active.Stroke
        end)

        toggleButton.MouseEnter:Connect(function()
            safeTween(toggleButton, ANIM.Fast, { BackgroundColor3 = theme.SurfaceAlt })
        end)
        toggleButton.MouseLeave:Connect(function()
            safeTween(toggleButton, ANIM.Fast, { BackgroundColor3 = theme.Surface })
        end)
        toggleButton.MouseButton1Click:Connect(function()
            Window:Toggle()
        end)

        if getgenv then
            getgenv().XELIB_ToggleBtn = toggleButton
        end
    end

    table.insert(Window._connections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end
        if input.KeyCode == toggleKey then
            Window:Toggle()
        end
    end))

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        applyFilter(tabs[activeTabId], searchBox.Text)
    end)

    -- Tabs are created by the script after this returns; the first one
    -- activates itself. Until then the content area stays empty.

    uiScale.Scale = 0.97
    safeTween(uiScale, ANIM.Normal, { Scale = 1 })

    return Window
end

local function Create(config)
    return XELIB:MakeWindow(config)
end

XELIB.Create = Create

return XELIB
