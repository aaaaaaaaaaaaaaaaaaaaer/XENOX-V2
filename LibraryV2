    function Window:Notify(titleText, message, duration)
        duration = math.clamp(tonumber(duration) or 3, 1, 10)
        notificationOrder += 1

        if #notifications >= 4 then
            local oldest = table.remove(notifications, 1)
            if oldest then
                pcall(function()
                    oldest.dismiss()
                end)
            end
        end

