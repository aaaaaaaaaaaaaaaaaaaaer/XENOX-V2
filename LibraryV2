                if not listening then
                    safeTween(button, ANIM.Fast, { BackgroundColor3 = theme.SurfaceAlt })
                end
            end)

            button.MouseButton1Click:Connect(function()
                if listening then
                    return
                end
                listening = true
                label.Text = "Press a key"
                label.TextColor3 = theme.Accent
                safeTween(buttonStroke, ANIM.Fast, { Color = theme.Accent, Transparency = 0 })

                local connection
                local finished = false

                local function finish(newKey)
                    if finished then
                        return
                    end
                    finished = true
                    listening = false
                    if connection then
                        pcall(function()
                            connection:Disconnect()
                        end)
                        connection = nil
                    end

                    if newKey then
                        currentKey = newKey
                    end

                    label.Text = currentKey.Name
                    label.TextColor3 = theme.Text
                    safeTween(buttonStroke, ANIM.Fast, {
                        Color = theme.Stroke,
                        Transparency = 0.2,
                    })

                    if newKey and type(callback) == "function" then
                        pcall(callback, newKey)
                    end
                end

                connection = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed then
                        return
                    end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        finish(input.KeyCode)
                    end
                end)
                table.insert(Window._connections, connection)
                task.delay(5, function()
                    finish(nil)
                end)
            end)

            attachTooltip(row, description)
            addEntry(row, key)

            if type(callback) == "function" and currentKey ~= Enum.KeyCode.Unknown then
                task.defer(function()
                    pcall(callback, currentKey)
                end)
            end
        end

