            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = theme.Text,
            TextTransparency = 1,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 802,
        }, card)

        local messageLabel = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(22, 28),
            Size = UDim2.new(1, -34, 0, 15),
            Font = FONT_REGULAR,
            Text = tostring(message or ""),
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = theme.Muted,
            TextTransparency = 1,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 802,
        }, card)

        local progress = create("Frame", {
            Position = UDim2.new(0, 0, 1, -2),
            Size = UDim2.new(1, 0, 0, 2),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel = 0,
            BackgroundTransparency = 1,
            ZIndex = 802,
        }, card)

        bindTheme(function(active)
            card.BackgroundColor3 = active.Surface
            cardStroke.Color = active.Stroke
            accent.BackgroundColor3 = active.Accent
            titleLabel.TextColor3 = active.Text
            messageLabel.TextColor3 = active.Muted
            progress.BackgroundColor3 = active.Accent
        end)

        local entry
        local closed = false

        local function dismiss()
            if closed then
                return
            end
            closed = true

            for index, item in ipairs(notifications) do
                if item == entry then
                    table.remove(notifications, index)
                    break
                end
            end

            if not card.Parent then
                return
            end

            safeTween(card, ANIM.Fast, { BackgroundTransparency = 1 })
            safeTween(cardScale, ANIM.Fast, { Scale = 0.96 })
            safeTween(cardStroke, ANIM.Fast, { Transparency = 1 })
            safeTween(accent, ANIM.Fast, { BackgroundTransparency = 1 })
            safeTween(titleLabel, ANIM.Fast, { TextTransparency = 1 })
            safeTween(messageLabel, ANIM.Fast, { TextTransparency = 1 })
            safeTween(progress, ANIM.Fast, { BackgroundTransparency = 1 })
            task.delay(0.25, function()
                if card.Parent then
                    card:Destroy()
                end
            end)
        end

        entry = { dismiss = dismiss }
        table.insert(notifications, entry)

        card.MouseButton1Click:Connect(dismiss)

        safeTween(card, ANIM.Normal, { BackgroundTransparency = 0.04 })
        safeTween(cardScale, ANIM.Normal, { Scale = 1 })
        safeTween(cardStroke, ANIM.Normal, { Transparency = 0.15 })
        safeTween(accent, ANIM.Normal, { BackgroundTransparency = 0 })
        safeTween(titleLabel, ANIM.Normal, { TextTransparency = 0 })
        safeTween(messageLabel, ANIM.Normal, { TextTransparency = 0 })
        safeTween(progress, ANIM.Normal, { BackgroundTransparency = 0 })
        safeTween(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 0, 2),
        })

        task.delay(duration, dismiss)
        return entry
    end

