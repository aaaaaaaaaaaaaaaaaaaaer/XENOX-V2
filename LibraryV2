local FONT_MEDIUM = Enum.Font.GothamMedium
local FONT_REGULAR = Enum.Font.Gotham
local FONT_MONO = Enum.Font.Code

local ANIM = {
    Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    Normal = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    Slow = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    Linear = TweenInfo.new(0.25, Enum.EasingStyle.Linear),
}

local DEFAULT_THEME = {
    Window = Color3.fromRGB(17, 18, 22),
    Sidebar = Color3.fromRGB(13, 14, 17),
    Surface = Color3.fromRGB(23, 25, 30),
    SurfaceAlt = Color3.fromRGB(31, 34, 41),
    Stroke = Color3.fromRGB(45, 48, 57),
    Accent = Color3.fromRGB(124, 96, 255),
    Text = Color3.fromRGB(235, 236, 240),
    Muted = Color3.fromRGB(138, 143, 155),
    Danger = Color3.fromRGB(237, 96, 96),
    Success = Color3.fromRGB(84, 201, 145),
}

-- Helpers --------------------------------------------------------------------

local RNG = Random.new()

local function randomString(length)
    length = length or 12
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local out = {}
    for index = 1, length do
        local at = RNG:NextInteger(1, #chars)
        out[index] = chars:sub(at, at)
    end
    return table.concat(out)
end

local function clampChannel(value)
    return math.clamp(math.floor(value + 0.5), 0, 255)
end

local function shiftColor(color, amount)
    return Color3.fromRGB(
        clampChannel(color.R * 255 + amount),
        clampChannel(color.G * 255 + amount),
        clampChannel(color.B * 255 + amount)
    )
end

local function getSafeParent()
    local ok, hui = pcall(function()
        return gethui and gethui()
    end)
    if ok and typeof(hui) == "Instance" then
        return hui
    end
    if PlayerGui and PlayerGui.Parent then
        return PlayerGui
    end
    local okCore, core = pcall(function()
        return CoreGui
    end)
    if okCore and core then
        return core
    end
    return PlayerGui or CoreGui
end

local function create(className, properties, parent)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    if parent then
        object.Parent = parent
    end
    return object
end

local function addCorner(object, radius)
    local corner = create("UICorner", { CornerRadius = UDim.new(0, radius) }, object)
    return corner
end

local function addStroke(object, color, thickness, transparency)
    local stroke = create("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, object)
    return stroke
end

local function safeTween(object, info, properties)
    if not object or not object.Parent then
        return nil
    end
    local ok, tween = pcall(function()
        return TweenService:Create(object, info, properties)
    end)
    if ok and tween then
        pcall(function()
            tween:Play()
        end)
        return tween
    end
    return nil
end

local function colorToHex(color)
    return string.format(
        "#%02X%02X%02X",
        clampChannel(color.R * 255),
        clampChannel(color.G * 255),
        clampChannel(color.B * 255)
    )
end

local function isInside(object, x, y)
    if not object or not object.Parent then
        return false
    end
    local position = object.AbsolutePosition
    local size = object.AbsoluteSize
    return x >= position.X and x <= position.X + size.X
        and y >= position.Y and y <= position.Y + size.Y
end

local function mergeTheme(base, override)
    local merged = {}
    for key, value in pairs(base) do
        merged[key] = value
    end
    if type(override) == "table" then
        for key, value in pairs(override) do
            if merged[key] ~= nil and typeof(value) == typeof(merged[key]) then
                merged[key] = value
            end
        end
    end
    return merged
end

local function makeDraggable(frame, handle, gui, connections)
    if not frame or not handle then
        return
    end

    local dragging = false
    local startMouse = nil
    local startPosition = nil
    local moveConnection = nil

    local function stopDragging()
        dragging = false
        if moveConnection then
            pcall(function()
                moveConnection:Disconnect()
            end)
            moveConnection = nil
        end
    end

    local press = handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local absolute = frame.AbsolutePosition
        frame.Position = UDim2.fromOffset(absolute.X, absolute.Y)
        dragging = true
        startMouse = input.Position
        startPosition = frame.Position

        if moveConnection then
            moveConnection:Disconnect()
        end

        moveConnection = UserInputService.InputChanged:Connect(function(changed)
            if not dragging then
                return
            end
            if changed.UserInputType ~= Enum.UserInputType.MouseMovement
                and changed.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            local delta = changed.Position - startMouse
            local limitX = math.max(0, gui.AbsoluteSize.X - frame.AbsoluteSize.X)
            local limitY = math.max(0, gui.AbsoluteSize.Y - frame.AbsoluteSize.Y)

            frame.Position = UDim2.fromOffset(
                math.clamp(startPosition.X.Offset + delta.X, 0, limitX),
                math.clamp(startPosition.Y.Offset + delta.Y, 0, limitY)
            )
        end)
        table.insert(connections, moveConnection)
    end)

    local release = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            stopDragging()
        end
    end)

    table.insert(connections, press)
    table.insert(connections, release)
    table.insert(connections, frame.AncestryChanged:Connect(function(_, parent)
        if not parent then
            stopDragging()
        end
    end))
end

-- Window ---------------------------------------------------------------------

function XELIB:MakeWindow(config)
    config = config or {}

    if getgenv then
        pcall(function()
            if getgenv().XELIB_ActiveGui and typeof(getgenv().XELIB_ActiveGui) == "Instance" then
                getgenv().XELIB_ActiveGui:Destroy()
            end
            getgenv().XELIB_ActiveGui = nil
            if getgenv().XELIB_ToggleBtn and typeof(getgenv().XELIB_ToggleBtn) == "Instance" then
                getgenv().XELIB_ToggleBtn:Destroy()
            end
            getgenv().XELIB_ToggleBtn = nil
        end)
    end

    local Window = {}
    setmetatable(Window, { __index = XELIB })
    Window._connections = {}
    Window._destroyed = false

    local theme = mergeTheme(DEFAULT_THEME, config.Theme)

    local windowName = tostring(config.Name or "Interface")
    local subTitle = tostring(config.SubTitle or "")
    local iconAsset = config.Icon
    local introEnabled = config.Intro == true or config.LoadIntro == true
    local introText = tostring(config.IntroText or "Loading")
    local introSpeed = math.clamp(tonumber(config.IntroSpeed) or 1, 0.3, 5)
    local toggleKey = config.ToggleKey or config.Keybind or Enum.KeyCode.RightControl
    if typeof(toggleKey) ~= "EnumItem" then
        toggleKey = Enum.KeyCode.RightControl
    end
    local closeCallback = config.CloseCallback
    local windowSize = config.Size
    if typeof(windowSize) ~= "UDim2" then
        windowSize = UDim2.fromOffset(720, 470)
    end

    local isOpen = true
    local isMinimized = false
    local minimizedSize = nil
    local activeTabId = 0
    local tabs = {}
    local tabCount = 0
    local notifications = {}
    local notificationOrder = 0
    local themeBindings = {}
    local popovers = {}

    -- Declared up front so helpers defined below capture the local, not a global.
    local screenGui = nil
    local toggleButton = nil

    local innerWidth = math.max(160, windowSize.X.Offset - SIDEBAR_WIDTH - 58)

    local function bindTheme(callback)
        table.insert(themeBindings, callback)
        pcall(callback, theme)
    end

    local function refreshTheme()
        for _, callback in ipairs(themeBindings) do
            pcall(callback, theme)
        end
    end

    local function closePopovers(except)
        for _, close in ipairs(popovers) do
            if close ~= except then
                pcall(close)
            end
        end
    end

    -- Tooltip ---------------------------------------------------------------

    local function attachTooltip(target, text)
        if type(text) ~= "string" or text == "" then
            return
        end

        local tip = create("Frame", {
            Name = "Tooltip",
            BackgroundColor3 = theme.SurfaceAlt,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 9000,
            BackgroundTransparency = 1,
        }, screenGui)
        addCorner(tip, 6)
        local tipStroke = addStroke(tip, theme.Stroke, 1, 1)
        local tipLabel = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(9, 7),
            Size = UDim2.new(1, -18, 1, -14),
            Font = FONT_REGULAR,
            Text = text,
            TextSize = 11,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextColor3 = theme.Text,
            TextTransparency = 1,
            ZIndex = 9001,
        }, tip)

        bindTheme(function(active)
            tip.BackgroundColor3 = active.SurfaceAlt
            tipStroke.Color = active.Stroke
            tipLabel.TextColor3 = active.Text
        end)

        local function show()
            if not target.Parent or screenGui.AbsoluteSize.X < 20 then
                return
            end

            local bounds = TextService:GetTextSize(
                text,
                11,
                FONT_REGULAR,
                Vector2.new(202, 1000)
            )
            local height = math.clamp(bounds.Y + 18, 28, 130)
            local width = 220
            local absolute = target.AbsolutePosition
            local size = target.AbsoluteSize

            local x = math.clamp(
                absolute.X + size.X * 0.5 - width * 0.5,
                8,
                math.max(8, screenGui.AbsoluteSize.X - width - 8)
            )
            local y = absolute.Y - height - 8
            if y < 8 then
                y = absolute.Y + size.Y + 8
            end
            y = math.clamp(y, 8, math.max(8, screenGui.AbsoluteSize.Y - height - 8))

            tip.Size = UDim2.fromOffset(width, height)
            tip.Position = UDim2.fromOffset(x, y)
            tip.Visible = true
            safeTween(tip, ANIM.Fast, { BackgroundTransparency = 0.04 })
            safeTween(tipStroke, ANIM.Fast, { Transparency = 0 })
            safeTween(tipLabel, ANIM.Fast, { TextTransparency = 0 })
        end

        local function hide()
            if not tip.Parent then
                return
            end
            safeTween(tip, ANIM.Fast, { BackgroundTransparency = 1 })
            safeTween(tipStroke, ANIM.Fast, { Transparency = 1 })
            safeTween(tipLabel, ANIM.Fast, { TextTransparency = 1 })
            task.delay(0.16, function()
                if tip.Parent then
                    tip.Visible = false
                end
            end)
        end

        table.insert(Window._connections, target.MouseEnter:Connect(show))
        table.insert(Window._connections, target.MouseLeave:Connect(hide))
    end

    -- Interface -------------------------------------------------------------

    screenGui = create("ScreenGui", {
        Name = randomString(14),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 50,
    }, getSafeParent())
    if not screenGui.Parent then
        screenGui.Parent = PlayerGui or CoreGui
    end
    if getgenv then
        getgenv().XELIB_ActiveGui = screenGui
    end

    local function runIntro()
        local introGui = create("ScreenGui", {
            Name = randomString(10),
            ResetOnSpawn = false,
            IgnoreGuiInset = true,
            DisplayOrder = 90,
        }, getSafeParent())

        local backdrop = create("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(10, 11, 14),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
        }, introGui)

        local introIcon = config.IntroIcon or config.Icon
        local hasIntroIcon = type(introIcon) == "string" and introIcon ~= ""
        local iconOffset = hasIntroIcon and 38 or 0

        local stack = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.fromOffset(240, 112 + iconOffset),
            BackgroundTransparency = 1,
        }, backdrop)

        local introImage = nil
        if hasIntroIcon then
            introImage = create("ImageLabel", {
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 0),
                Size = UDim2.fromOffset(26, 26),
                BackgroundTransparency = 1,
                Image = introIcon,
                ImageTransparency = 1,
            }, stack)
        end

        local title = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, 26 + iconOffset),
            Size = UDim2.new(1, 0, 0, 18),
            Font = FONT_BOLD,
            Text = string.upper(introText),
            TextSize = 13,
            TextColor3 = Color3.fromRGB(235, 236, 240),
            TextTransparency = 1,
        }, stack)

        local caption = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, 46 + iconOffset),
            Size = UDim2.new(1, 0, 0, 14),
            Font = FONT_REGULAR,
            Text = windowName,
            TextSize = 11,
            TextColor3 = Color3.fromRGB(120, 125, 138),
            TextTransparency = 1,
        }, stack)

        local track = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, 76 + iconOffset),
            Size = UDim2.fromOffset(160, 2),
            BackgroundColor3 = Color3.fromRGB(38, 41, 49),
            BorderSizePixel = 0,
            BackgroundTransparency = 1,
        }, stack)
        addCorner(track, 1)

        local fill = create("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel = 0,
            BackgroundTransparency = 1,
        }, track)
        addCorner(fill, 1)

        safeTween(backdrop, ANIM.Slow, { BackgroundTransparency = 0 })
        task.wait(0.12)
        if introImage then
            safeTween(introImage, ANIM.Slow, { ImageTransparency = 0 })
        end
        safeTween(title, ANIM.Slow, { TextTransparency = 0 })
        safeTween(caption, ANIM.Slow, { TextTransparency = 0 })
        safeTween(track, ANIM.Slow, { BackgroundTransparency = 0.45 })
        safeTween(fill, ANIM.Slow, { BackgroundTransparency = 0 })
        task.wait(0.08)
        safeTween(fill, TweenInfo.new(introSpeed, Enum.EasingStyle.Linear), {
            Size = UDim2.new(1, 0, 1, 0),
        })
        task.wait(introSpeed + 0.12)
        safeTween(backdrop, ANIM.Slow, { BackgroundTransparency = 1 })
        if introImage then
            safeTween(introImage, ANIM.Slow, { ImageTransparency = 1 })
        end
        safeTween(title, ANIM.Slow, { TextTransparency = 1 })
        safeTween(caption, ANIM.Slow, { TextTransparency = 1 })
        safeTween(track, ANIM.Slow, { BackgroundTransparency = 1 })
        safeTween(fill, ANIM.Slow, { BackgroundTransparency = 1 })
        task.wait(0.32)
        introGui:Destroy()
    end

    if introEnabled then
        runIntro()
    end

    local main = create("Frame", {
        Name = randomString(12),
        Size = windowSize,
        Position = UDim2.new(0.5, -windowSize.X.Offset * 0.5, 0.5, -windowSize.Y.Offset * 0.5),
        BackgroundColor3 = theme.Window,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
    }, screenGui)
    addCorner(main, 10)

    local mainStroke = addStroke(main, theme.Stroke, 1, 0)

    local uiScale = create("UIScale", { Scale = 1 }, main)

    bindTheme(function(active)
        main.BackgroundColor3 = active.Window
        mainStroke.Color = active.Stroke
    end)

    -- Header -----------------------------------------------------------------

    local header = create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
        BackgroundTransparency = 1,
        Active = true,
        ZIndex = 3,
    }, main)

    local titleX = 18
    if type(iconAsset) == "string" and iconAsset ~= "" then
        local icon = create("ImageLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(18, (HEADER_HEIGHT - 20) * 0.5),
            Size = UDim2.fromOffset(20, 20),
            Image = iconAsset,
            ZIndex = 4,
        }, header)
        icon.Name = "WindowIcon"
        titleX = 46
    end

    local title = create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(titleX, subTitle ~= "" and 10 or 0),
        Size = UDim2.new(1, -140, 0, subTitle ~= "" and 18 or HEADER_HEIGHT),
        Font = FONT_BOLD,
        Text = windowName,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = subTitle ~= "" and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 4,
    }, header)

    local subtitle = nil
    if subTitle ~= "" then
        subtitle = create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(titleX, 29),
            Size = UDim2.new(1, -140, 0, 14),
            Font = FONT_REGULAR,
            Text = subTitle,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 4,
        }, header)
    end

    bindTheme(function(active)
        title.TextColor3 = active.Text
        if subtitle then
            subtitle.TextColor3 = active.Muted
        end
    end)

    local function makeWindowButton(offsetX, iconKind)
        local button = create("TextButton", {
            Size = UDim2.fromOffset(26, 26),
            Position = UDim2.new(1, offsetX, 0, 14),
            BackgroundColor3 = theme.SurfaceAlt,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 6,
        }, header)
        addCorner(button, 6)

        local bar = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.fromOffset(10, 1),
            BackgroundColor3 = theme.Muted,
            BorderSizePixel = 0,
            ZIndex = 7,
        }, button)

        local second = nil
        if iconKind == "close" then
            bar.Rotation = 45
            second = create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.fromOffset(10, 1),
                BackgroundColor3 = theme.Muted,
                BorderSizePixel = 0,
                Rotation = -45,
                ZIndex = 7,
            }, button)
        else
            second = create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.fromOffset(1, 10),
                BackgroundColor3 = theme.Muted,
                BorderSizePixel = 0,
                Visible = false,
                ZIndex = 7,
            }, button)
        end

        bindTheme(function(active)
            bar.BackgroundColor3 = active.Muted
            second.BackgroundColor3 = active.Muted
        end)

        button.MouseEnter:Connect(function()
            safeTween(button, ANIM.Fast, { BackgroundTransparency = 0 })
            safeTween(bar, ANIM.Fast, {
                BackgroundColor3 = iconKind == "close" and theme.Danger or theme.Text,
            })
            safeTween(second, ANIM.Fast, {
                BackgroundColor3 = iconKind == "close" and theme.Danger or theme.Text,
            })
        end)
        button.MouseLeave:Connect(function()
            safeTween(button, ANIM.Fast, { BackgroundTransparency = 1 })
            safeTween(bar, ANIM.Fast, { BackgroundColor3 = theme.Muted })
            safeTween(second, ANIM.Fast, { BackgroundColor3 = theme.Muted })
        end)

        return button, second
    end

    local closeButton = makeWindowButton(-36, "close")
