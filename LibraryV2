                if type(stateLabels) == "table" then
                    label.Text = enabled
                        and tostring(stateLabels.On or key)
                        or tostring(stateLabels.Off or key)
                elseif type(stateLabels) == "string" then
                    label.Text = stateLabels .. (enabled and " · On" or " · Off")
