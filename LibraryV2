                    and not isInside(swatch, mouse.X, mouse.Y) then
                    close()
                end
            end))

            render(false)
            attachTooltip(row, description)
            addEntry(row, key)

            if type(callback) == "function" then
                task.defer(function()
                    pcall(callback, defaultColor)
                end)
            end
        end

        return tab
